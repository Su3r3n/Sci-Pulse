# Скрипты и конфиги монтируются в Linux-контейнеры: на Windows Git не должен превращать LF в CRLF
# (иначе `set -euo pipefail\r` -> "invalid option name", pg-init завершается с кодом 2).
* text=auto
*.sh        text eol=lf
*.sql       text eol=lf
*.py        text eol=lf
*.go        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.avsc      text eol=lf
*.properties text eol=lf
*.example   text eol=lf
*.xml       text eol=lf
*.csv       text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
.env.example text eol=lf
*.exe       binary
