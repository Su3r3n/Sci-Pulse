# =============================================================================
# SciPulse Platform — Environment Configuration
# Copy to .env and adjust secrets before running `make up`
# =============================================================================

# --- Image Versions ---
POSTGRES_IMAGE=postgres:16-alpine
KAFKA_IMAGE=apache/kafka:3.9.0
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:7.7.1
DEBEZIUM_IMAGE=debezium/connect:2.7.3.Final
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8-alpine
MINIO_IMAGE=minio/minio:RELEASE.2024-10-13T13-34-11Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-10-08T09-37-26Z
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:11.3.0
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.8.0
AIRFLOW_IMAGE=apache/airflow:3.0.0

# --- Postgres (4 databases in 1 instance) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_admin_dev_pass
REGISTRY_DB=registry
REGISTRY_DB_USER=registry_app
REGISTRY_DB_PASSWORD=registry_dev_pass
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=debezium_dev_pass
ICEBERG_DB=iceberg_catalog
ICEBERG_DB_USER=iceberg
ICEBERG_DB_PASSWORD=iceberg_dev_pass
HARVESTER_DB=harvester
HARVESTER_DB_USER=harvester_app
HARVESTER_DB_PASSWORD=harvester_dev_pass
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev_pass

# --- MinIO (S3A for Iceberg & Checkpoints) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_pass
S3_WAREHOUSE_BUCKET=warehouse

# --- ClickHouse ---
CLICKHOUSE_DB=scipulse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_GRAFANA_PASSWORD=grafana_ro_dev_pass
CLICKHOUSE_SPARK_PASSWORD=spark_writer_dev_pass

# --- Services API Keys & External Tokens ---
REGISTRY_API_KEY=scipulse-registry-dev-key-change-me
OPENALEX_API_KEY=
GITHUB_TOKEN=

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_TELEGRAM_BOT_TOKEN=
GF_TELEGRAM_CHAT_ID=

# --- Airflow ---
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=
AIRFLOW__API_AUTH__JWT_SECRET=scipulse-airflow-jwt-dev-secret-change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Seed / Demo ---
SEED_URL=http://127.0.0.1:8080
